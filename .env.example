# ============================================================
# TeaParty-Bell (小G宝) 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================================

# --- Discord ---
# Discord Bot Token（从 Discord Developer Portal 获取）
DISCORD_BOT_TOKEN=your_bot_token_here

# Discord Application ID
DISCORD_APPLICATION_ID=your_application_id_here

# 目标服务器 ID
DISCORD_GUILD_ID=your_guild_id_here

# 感谢消息发送频道 ID
DISCORD_THANKS_CHANNEL_ID=your_channel_id_here

# --- AI Provider（OpenAI-compatible /chat/completions）---
# 新配置启用后，不得同时保留任意 DEEPSEEK_* 配置。
AI_PROTOCOL=openai_compatible
AI_BASE_URL=https://api.example.com/v1
# 可选：设置后直接使用此完整 Endpoint，覆盖 AI_BASE_URL。
AI_CHAT_COMPLETIONS_URL=
# 留空时不发送鉴权 Header，适用于本地无鉴权代理。
AI_API_KEY=
AI_MODEL=model-id
AI_TIMEOUT_MS=30000
AI_AUTH_HEADER=Authorization
AI_AUTH_SCHEME=Bearer
AI_BACKEND_LABEL=OpenAI Compatible
# 必须是 JSON 对象；Headers 的值必须都是字符串。
AI_EXTRA_HEADERS_JSON={}
AI_EXTRA_BODY_JSON={}

# --- 旧 DeepSeek 配置（兼容用途；请不要与 AI_* 同时设置）---
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_MS=30000

# --- 应用行为 ---
# 运行环境：development | test | production
# 未设置时默认 development。
# VPS systemd service 必须显式设置 NODE_ENV=production
NODE_ENV=development

# 测试模式：true 时不发送真实消息，日志输出本应发送的内容
TEST_MODE=false

# 日志等级：error | warn | info | debug
LOG_LEVEL=info

# Reaction 数量（约 8～10 个，默认 10）
REACTION_COUNT=10

# 连续助力聚合窗口（毫秒，默认 15000 = 15 秒）
BOOST_AGGREGATION_WINDOW_MS=15000

# --- Forum Bump（Stage D-5）---
# disabled | dry_run | execute（默认 disabled；未知值配置失败）
FORUM_BUMP_MODE=disabled
# 逗号分隔 Forum Channel Snowflake（dry_run/execute 至少一个）
FORUM_BUMP_FORUM_CHANNEL_IDS=
# 排除的标签 ID（可选）
FORUM_BUMP_EXCLUDED_TAG_IDS=
FORUM_BUMP_SILENCE_DAYS=30
FORUM_BUMP_SKIP_PINNED=true
# 每日完整成功额度（1–30；实际上限 = min(30, floor(活跃分钟/30))；首次启用建议 3）
FORUM_BUMP_DAILY_LIMIT=3
FORUM_BUMP_COOLDOWN_MINUTES=40
FORUM_BUMP_COOLDOWN_JITTER_MINUTES=10
FORUM_BUMP_IDLE_POLL_MINUTES=30
FORUM_BUMP_FAILURE_BACKOFF_MINUTES=5
FORUM_BUMP_TIMEZONE=Asia/Shanghai
FORUM_BUMP_ACTIVE_START=10:00
FORUM_BUMP_ACTIVE_END=22:00
FORUM_BUMP_STATE_PATH=data/runtime/forum-bump/state.json
# 动态配置（管理员可热更新四项；缺失时使用上方 .env 基线）
FORUM_BUMP_DYNAMIC_CONFIG_PATH=data/runtime/forum-bump/config.json
# 注意：成功顶帖间隔 = 活跃窗时长 ÷ dailyLimit（最短 30 分钟），不再使用 COOLDOWN 固定值
